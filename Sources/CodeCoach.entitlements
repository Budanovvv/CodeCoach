<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Outbound HTTPS to the Claude API. Screen Recording and Accessibility are
	     TCC grants, not entitlements, so they are not listed here. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
